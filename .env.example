# ─────────────────────────────────────────────────────────────
#  متغيّرات البيئة — روضة ماما زينب
#  انسخ هذا الملف إلى .env.local للتطوير المحلّي،
#  وأضِف القيم نفسها في Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# رابط مشروع Supabase.
# أين تجده: Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# مفتاح service_role السرّي. يُستعمل في الخادم فقط (مسار /api/lead)
# لإدراج التسجيلات في جدول leads. لا تضعه أبداً في متغيّر يبدأ بـ NEXT_PUBLIC_
# ولا تشاركه مع أحد — من يملكه يملك قاعدة البيانات كاملة.
# أين تجده: Supabase → Project Settings → API Keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# معرّف بيكسل ميتا. يُحمَّل في المتصفّح بعد أول تفاعل من الزائر فقط.
# معرّف روضة ماما زينب (2615027122286387) مكتوب أصلاً في lib/pixel.ts،
# فلا حاجة لضبط هذا المتغيّر. اضبطه فقط إن أردت استعمال بيكسل آخر
# (مثلاً بيكسل تجريبي أثناء التطوير) — قيمته تتقدّم على المكتوب في الكود.
# أين تجده: Meta Events Manager → Data Sources → Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# ── اختياري: Conversions API — إرسال حدث Lead من الخادم مباشرة إلى ميتا
# مطبَّق في lib/capi/send.ts ويُستدعى تلقائياً من app/api/lead/route.ts.
# بدون هذا المتغيّر تُتخطّى العملية بصمت — لا يتعطّل حفظ التسجيل ولا بيكسل
# المتصفّح إطلاقاً.
# أين تجده: Meta Events Manager → Settings → Conversions API → Generate access token
META_CAPI_ACCESS_TOKEN=

# اختياري: كود اختبار من تبويب Test Events في Meta Events Manager —
# يجعل الأحداث تظهر هناك فوراً للتحقّق دون احتسابها في التقارير الحقيقية.
# احذفه بعد الانتهاء من الاختبار.
META_CAPI_TEST_EVENT_CODE=

# ── اختياري: رابط الإشعار الفوري (Database Webhook) ────────────
# هذا المتغيّر لا تستعمله الصفحة — تضعه في Supabase نفسه عند إنشاء
# الـWebhook (انظر قسم "الإشعار الفوري" في README).
# مثال لتلغرام عبر n8n أو أي وسيط:
LEAD_WEBHOOK_URL=

# ── الإشعارات الفورية (Web Push) ──────────────────────────────
# المفتاح العام مكتوب في lib/push/config.ts (عام بطبيعته).
# المفتاح الخاص سرّي ويجب وضعه على Vercel لتعمل الإشعارات:
VAPID_PRIVATE_KEY=

# ملاحظة: الإشعارات تحتاج أيضاً SUPABASE_SERVICE_ROLE_KEY أعلاه،
# لأن قراءة اشتراكات الأجهزة تتجاوز سياسات RLS.
# بدون المفتاحين تُتخطّى الإشعارات بصمت ولا يتعطّل أي تسجيل.

# اختياري: لاستعمال مفتاح VAPID عام مختلف
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# اختياري: رابط Supabase ومفتاحه العام (مكتوبان في lib/supabase/config.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
