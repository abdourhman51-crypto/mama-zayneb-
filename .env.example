# ─────────────────────────────────────────────────────────────
#  متغيّرات البيئة — روضة ماما زينب
#  انسخ هذا الملف إلى .env.local للتطوير المحلّي،
#  وأضِف القيم نفسها في Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# رابط مشروع Supabase.
# أين تجده: Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# مفتاح service_role السرّي. يُستعمل في الخادم فقط (مسار /api/lead)
# لإدراج التسجيلات في جدول leads. لا تضعه أبداً في متغيّر يبدأ بـ NEXT_PUBLIC_
# ولا تشاركه مع أحد — من يملكه يملك قاعدة البيانات كاملة.
# أين تجده: Supabase → Project Settings → API Keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# معرّف بيكسل ميتا. يُحمَّل في المتصفّح بعد أول تفاعل من الزائر فقط.
# معرّف روضة ماما زينب (2615027122286387) مكتوب أصلاً في lib/pixel.ts،
# فلا حاجة لضبط هذا المتغيّر. اضبطه فقط إن أردت استعمال بيكسل آخر
# (مثلاً بيكسل تجريبي أثناء التطوير) — قيمته تتقدّم على المكتوب في الكود.
# أين تجده: Meta Events Manager → Data Sources → Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# ── اختياري: Conversions API (غير مفعّل حالياً) ────────────────
# البنية جاهزة في app/api/capi/route.ts ولكنها تعيد 501 حتى تُضاف هذه القيمة.
# أين تجده: Meta Events Manager → Settings → Conversions API → Generate access token
META_CAPI_ACCESS_TOKEN=

# ── اختياري: رابط الإشعار الفوري (Database Webhook) ────────────
# هذا المتغيّر لا تستعمله الصفحة — تضعه في Supabase نفسه عند إنشاء
# الـWebhook (انظر قسم "الإشعار الفوري" في README).
# مثال لتلغرام عبر n8n أو أي وسيط:
LEAD_WEBHOOK_URL=
